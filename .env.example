# Required for Vercel Production: public Cloudflare Worker origin backed by private R2. Set at build time
# only after the public dashboard assets have been reviewed for source-use rights.
# Leave blank only for local/preview builds that use bundled source-derived data.
NEXT_PUBLIC_ANALYTICS_DATA_BASE_URL=

# Operator-only Cloudflare settings. Copy into ignored .env.local.
# These are used by scripts/configure_dashboard_worker.mjs, not the browser.
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET_NAME=
CLOUDFLARE_WORKER_NAME=
DASHBOARD_ALLOWED_ORIGINS=
