{
  "name": "dashboard-data",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "r2_buckets": [{ "binding": "DASHBOARD_DATA", "bucket_name": "CONFIGURE_FROM_ENV" }],
  "ratelimits": [{ "name": "DATA_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
  "vars": { "ALLOWED_ORIGINS": "CONFIGURE_FROM_ENV" },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
